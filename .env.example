# تشغيل مشترك: المفتاح سر خادمي دائم، ولا يدخله المستخدمون ولا يصل إلى المتصفح.
# انسخ الملف إلى .env للتجربة على خادم خاص فقط. في الاستضافة العامة ضع القيم في Secret/Environment Settings لدى المستضيف.
RAFID_DEPLOYMENT_MODE=shared
RAFID_PROVIDER_CONFIGURATION_MODE=server
RAFID_HOST=0.0.0.0

AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# strict_zdr يمنع الاتصال حتى تؤكد أن حساب المؤسسة معتمد لـ Zero Data Retention.
# standard يستخدم store:false، لكن قد تبقى سجلات مراقبة لدى المزود وفق سياسته.
RAFID_DATA_POLICY=strict_zdr
GROQ_ZERO_DATA_RETENTION_CONFIRMED=false
GROQ_REASONING_EFFORT=low
GROQ_MAX_TEXT_CHARS=5000
GROQ_MAX_OPPORTUNITY_SOURCE_CHARS=6000
GROQ_MAX_OPPORTUNITY_CHARS=5000
GROQ_MAX_PROJECT_JSON_CHARS=6000
GROQ_MAX_OUTPUT_TOKENS=2600
RAFID_REASONING_EFFORT=high

# حسابات المستخدمين والحفظ التلقائي عبر Supabase.
# SUPABASE_PUBLISHABLE_KEY مفتاح عام مصمم للواجهة؛ لا تستخدم service_role أبدًا هنا أو في المتصفح.
RAFID_AUTH_REQUIRED=true
RAFID_AUTH_PROVIDERS=google,azure,github,email
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# حماية حصة Groq المشتركة. كل تحليل/استخراج يستهلك عملية واحدة.
RAFID_RATE_LIMIT_REQUESTS=12
RAFID_RATE_LIMIT_WINDOW_SECONDS=600
RAFID_GLOBAL_DAILY_AI_LIMIT=240

RAFID_MAX_TEXT_CHARS=120000
RAFID_MAX_OPPORTUNITY_CHARS=90000
RAFID_MAX_PROJECT_JSON_CHARS=110000
RAFID_MAX_REQUEST_BYTES=1500000
RAFID_ALLOW_CONFIDENTIAL_STANDARD_PROCESSING=false
RAFID_ALLOW_CONFIDENTIAL_CLOUD_PERSISTENCE=false
RAFID_ALLOW_RESTRICTED_REMOTE_PROCESSING=false

# اتركه فارغًا عند استخدام تسجيل Supabase. يفيد فقط في وضع خادم خاص بلا حسابات.
RAFID_ACCESS_TOKEN=

# OpenAI اختياري: غيّر AI_PROVIDER إلى openai.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ZERO_DATA_RETENTION_CONFIRMED=false

# بديل محلي اختياري: غيّر AI_PROVIDER إلى ollama بعد تثبيت Ollama وتنزيل النموذج.
# وغيّر RAFID_DEPLOYMENT_MODE إلى local وRAFID_PROVIDER_CONFIGURATION_MODE إلى local_session وRAFID_AUTH_REQUIRED إلى false.
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=gpt-oss:20b
