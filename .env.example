# هذا الملف للخادم فقط. لا تنسخه إلى frontend ولا ترسله إلى المتصفح.
# انسخه محليًا إلى .env، واستخدم مدير أسرار الاستضافة في staging والإنتاج.
# جميع القيم الحساسة أدناه فارغة أو وهمية ويجب استبدالها خارج Git.

# تعريف التطبيق والتشغيل
APP_NAME=Rafid
APP_URL=http://127.0.0.1:8080
PORT=8080
RAFID_HOST=127.0.0.1
RAFID_DEPLOYMENT_MODE=local
RAFID_PROVIDER_CONFIGURATION_MODE=local_session
RAFID_ALLOWED_ORIGINS=http://127.0.0.1:8080

# مزود التحليل الافتراضي — أسرار خادم فقط
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ZERO_DATA_RETENTION_CONFIRMED=false
GROQ_REASONING_EFFORT=low
GROQ_ASSESSMENT_REASONING_EFFORT=medium
GROQ_MAX_TEXT_CHARS=5000
GROQ_MAX_OPPORTUNITY_SOURCE_CHARS=6000
GROQ_MAX_OPPORTUNITY_CHARS=5000
GROQ_MAX_PROJECT_JSON_CHARS=6000
GROQ_MAX_OUTPUT_TOKENS=2600

# سياسة المعالجة
RAFID_DATA_POLICY=strict_zdr
RAFID_REASONING_EFFORT=high
RAFID_ALLOW_LEGACY_REQUESTS=false
RAFID_ALLOW_CONFIDENTIAL_STANDARD_PROCESSING=false
RAFID_ALLOW_CONFIDENTIAL_CLOUD_PERSISTENCE=false
RAFID_ALLOW_RESTRICTED_REMOTE_PROCESSING=false

# Supabase: URL والمفتاح anonymous فقط يمكن أن يظهرا للمتصفح عبر public/config.
# SUPABASE_SERVICE_ROLE_KEY سر خادمي عالي الصلاحية، والتطبيق الحالي لا يحتاجه.
RAFID_AUTH_REQUIRED=false
RAFID_AUTH_PROVIDERS=google,azure,github,email
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=

# حدود واضحة تستخدمها الواجهة والخادم
MAX_FILE_SIZE_MB=20
MAX_ANALYSIS_INPUT_CHARS=16000
ANALYSIS_TIMEOUT_SECONDS=60
RATE_LIMIT_REQUESTS=12
RATE_LIMIT_WINDOW_MINUTES=10
RAFID_GLOBAL_DAILY_AI_LIMIT=240
RAFID_MAX_TEXT_CHARS=120000
RAFID_MAX_OPPORTUNITY_CHARS=90000
RAFID_MAX_PROJECT_JSON_CHARS=110000
RAFID_MAX_REQUEST_BYTES=1500000

# رمز وصول بديل لخادم خاص فقط. اتركه فارغًا عند استخدام Supabase.
RAFID_ACCESS_TOKEN=

# مزودات اختيارية — لا تفعلها مع Groq في الوقت نفسه.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ZERO_DATA_RETENTION_CONFIRMED=false
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
# AZURE_OPENAI_DEPLOYMENT=replace_with_deployment_name
# AZURE_ZERO_DATA_RETENTION_CONFIRMED=false
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=gpt-oss:20b
